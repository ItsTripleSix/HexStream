<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/hex_settings_app" app:iconSpaceReserved="false" />

    <ListPreference
        android:defaultValue="auto"
        android:entries="@array/languageEntries"
        android:entryValues="@array/language"
        android:key="ui_language"
        android:summary="@string/hex_help_root_ui_language"
        android:title="@string/language"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="ui_draw_behind_cutouts"
        android:summary="@string/hex_help_root_ui_draw_behind_cutouts"
        android:title="@string/draw_behind_cutouts"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="theme_settings"
        android:summary="@string/hex_help_root_theme_settings"
        android:title="@string/theme"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="ui_settings"
        android:summary="@string/hex_help_root_ui_settings"
        android:title="@string/ui_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="chat_settings"
        android:summary="@string/hex_help_root_chat_settings"
        android:title="@string/chat_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="live_notifications_enabled"
        android:summary="@string/hex_help_root_live_notifications_enabled"
        android:title="@string/live_notifications"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory android:title="@string/hex_settings_watching" app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="player_picture_in_picture"
        android:summary="@string/hex_help_root_player_picture_in_picture"
        android:title="@string/picture_in_picture"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="player_background_audio"
        android:summary="@string/hex_help_root_player_background_audio"
        android:title="@string/use_background_audio"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="player_background_audio_locked"
        android:summary="@string/hex_help_root_player_background_audio_locked"
        android:title="@string/use_background_audio_locked"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="player_settings"
        android:summary="@string/hex_help_root_player_settings"
        android:title="@string/player_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="player_button_settings"
        android:summary="@string/hex_help_root_player_button_settings"
        android:title="@string/player_buttons"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="buffer_settings"
        android:summary="@string/hex_help_root_buffer_settings"
        android:title="@string/buffer_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="playback_settings"
        android:summary="@string/hex_help_root_playback_settings"
        android:title="@string/playback_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory android:title="@string/hex_settings_proxies" app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="player_use_custom_proxy"
        android:summary="@string/hex_help_root_player_use_custom_proxy"
        android:title="@string/hex_playback_url_proxies"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="custom_proxy_settings"
        android:summary="@string/hex_help_root_custom_proxy_settings"
        android:title="@string/hex_playback_url_proxy_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="player_use_stream_proxy"
        android:summary="@string/hex_help_root_player_use_stream_proxy"
        android:title="@string/use_stream_proxies"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="stream_proxy_settings"
        android:summary="@string/hex_help_root_stream_proxy_settings"
        android:title="@string/hex_http_proxy_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory android:title="@string/hex_settings_data" app:iconSpaceReserved="false" />

    <Preference
        android:key="download_settings"
        android:summary="@string/hex_help_root_download_settings"
        android:title="@string/download_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="check_updates"
        android:summary="@string/hex_help_root_check_updates"
        android:title="@string/check_updates"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="update_settings"
        android:summary="@string/hex_help_root_update_settings"
        android:title="@string/update_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="backup_settings"
        android:summary="@string/hex_help_root_backup_settings"
        android:title="@string/backup_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="restore_settings"
        android:summary="@string/hex_help_root_restore_settings"
        android:title="@string/restore_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="hexstream_about"
        android:summary="@string/hex_help_root_hexstream_about"
        android:title="@string/about"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory android:title="@string/hex_settings_advanced" app:iconSpaceReserved="false" />

    <Preference
        android:key="api_token_settings"
        android:summary="@string/hex_help_root_api_token_settings"
        android:title="@string/api_token_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <ListPreference
        android:defaultValue="OkHttp"
        android:entries="@array/networkLibraryEntries"
        android:entryValues="@array/networkLibraryEntries"
        android:key="network_library"
        android:summary="@string/hex_help_root_network_library"
        android:title="@string/network_library"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="debug_settings"
        android:summary="@string/hex_help_root_debug_settings"
        android:title="@string/debug_settings"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
